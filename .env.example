# ── Backend (API) ──────────────────────────────
# API 待受ポート（コンテナ内）
PORT=3000

# Docker でホストに公開するポート（既定 3000 / 5432。衝突時に変更）
API_PORT=3000
POSTGRES_PORT=5432
# LP(landing) の公開ポート（Cloudflare Tunnel から向ける）
LANDING_PORT=8081
# landing の学校一覧ページが叩く公開API（ビルド時に埋め込み）
PUBLIC_API_BASE_URL=https://yasumi-api.unischool.jp
# landing の SEO 基準URL（canonical / og:url / sitemap。ビルド時に埋め込み）
PUBLIC_SITE_URL=https://yasumi.unischool.jp

# PostgreSQL 接続文字列（compose 内から接続する場合はホスト名 postgres）
DATABASE_URL=postgres://app:password@postgres:5432/yasumi

# LINE Messaging API / LIFF
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=
# LIFF(LINEログイン)チャネルID … IDトークン検証の client_id（PRD §21）
LIFF_CHANNEL_ID=
# LINE Login チャネルの secret（ネイティブアプリの LINE ログイン code 交換用 / LIFF と同じチャネル）
LINE_LOGIN_CHANNEL_SECRET=
# 管理者の LINE ユーザーID（カンマ区切り / 学校・ルール編集の許可 §23）
ADMIN_LINE_USER_IDS=

# ── FCM（ネイティブアプリの無料プッシュ通知）─────
# 3点が揃うと FCM プッシュ有効（デバイストークン登録済みユーザーへ優先送信）。
# 未設定なら LINE プッシュのみ。サービスアカウントの機微情報はサーバー限定・非コミット。
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
# 秘密鍵は改行を \n エスケープした1行で可（コード側で復元）
FCM_PRIVATE_KEY=

# ── 管理画面（Admin / id・password + JWT）──────
# JWT 署名鍵（強ランダム・必須。設定時のみ /api/admin 有効化）
ADMIN_JWT_SECRET=
# 管理画面フロントが叩く公開API
VITE_ADMIN_API_BASE_URL=https://yasumi-api.unischool.jp
# 管理画面フロントの公開ポート（Cloudflare Tunnel から向ける）
ADMIN_PORT=8083

# ── 先生ダッシュボード（School / teacher email・password + JWT）──────
# JWT 署名鍵（強ランダム・必須。設定時のみ /api/school 有効化。ADMIN_JWT_SECRET とは別値にする）
SCHOOL_JWT_SECRET=
# 先生ダッシュボード フロントが叩く公開API
VITE_SCHOOL_API_BASE_URL=https://yasumi-api.unischool.jp
# 先生ダッシュボード フロントの公開ポート（Cloudflare Tunnel から向ける。8084 は他用途で使用中のため 8085）
SCHOOL_PORT=8085
# 「確認しました」リンク(/c/:token)の絶対URL生成用。未設定なら本番APIドメインを既定に使う（任意）
API_PUBLIC_BASE_URL=https://yasumi-api.unischool.jp

# cron 内部エンドポイント (/api/internal/*) の認可トークン
INTERNAL_CRON_TOKEN=change-me

# ── Frontend (Vite / LIFF・MINI App) ───────────
# LIFF ID（例 2011524231-xxxxxxxx）と 公開APIのベースURL（ビルド時に埋め込み）
VITE_LIFF_ID=
VITE_API_BASE_URL=https://yasumi-api.unischool.jp
# フロント配信コンテナの公開ポート（Cloudflare Tunnel から向ける）
FRONTEND_PORT=8082

# ── PostgreSQL コンテナ ────────────────────────
POSTGRES_USER=app
POSTGRES_PASSWORD=password
POSTGRES_DB=yasumi
