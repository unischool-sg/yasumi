# ── Backend (API) ──────────────────────────────
# API 待受ポート
PORT=3000

# PostgreSQL 接続文字列（compose 内から接続する場合はホスト名 postgres）
DATABASE_URL=postgres://app:password@postgres:5432/yasumi

# LINE Messaging API / LIFF
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=

# cron 内部エンドポイント (/api/internal/*) の認可トークン
INTERNAL_CRON_TOKEN=change-me

# ── PostgreSQL コンテナ ────────────────────────
POSTGRES_USER=app
POSTGRES_PASSWORD=password
POSTGRES_DB=yasumi
