---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { OPERATOR } from "../consts";

const rows: { k: string; v: string }[] = [
  { k: "販売事業者", v: OPERATOR.name },
  { k: "運営統括責任者", v: OPERATOR.manager },
  { k: "所在地", v: "請求があれば遅滞なく開示します（下記メールアドレスへご連絡ください）" },
  { k: "電話番号", v: "請求があれば遅滞なく開示します" },
  { k: "メールアドレス", v: OPERATOR.email },
  { k: "販売URL", v: "https://yasumi.unischool.jp/for-schools" },
  { k: "販売価格", v: "学校向けプラン：ベーシック 月額2,500円／スタンダード 月額7,000円／プレミアム 月額18,000円〜（価格は税別。別途消費税を申し受けます）。生徒・保護者の利用は無料です。" },
  { k: "商品代金以外の必要料金", v: "本サービスの利用に必要なインターネット接続料金・通信料金等は利用者のご負担となります。" },
  { k: "お支払い方法", v: "請求書による銀行振込" },
  { k: "お支払い時期", v: "請求書に記載の支払期日までにお支払いください。" },
  { k: "サービスの提供時期", v: "お支払い確認後、または個別契約に定める時期より提供します。" },
  { k: "解約・返金", v: "役務提供の性質上、提供開始後の返金は原則行いません。契約期間途中での解約は次回更新の停止をもって行い、期間途中の日割り返金は行いません。" },
  { k: "動作環境", v: "LINE（ミニアプリ）および最新のモダンブラウザ。先生ダッシュボードは最新のモダンブラウザ。" },
];
---

<Layout title="特定商取引法に基づく表記 | やすみ？" description="やすみ？（学校向け有料プラン）の特定商取引法に基づく表記です。">
  <Header />
  <section class="legal">
    <div class="container">
      <h1>特定商取引法に基づく表記</h1>
      <p class="lead">本表記は、学校向け有料プランに関するものです。</p>
      <table class="tokusho">
        <tbody>
          {rows.map((r) => (
            <tr>
              <th>{r.k}</th>
              <td>{r.v}</td>
            </tr>
          ))}
        </tbody>
      </table>
      <p class="updated">運営：{OPERATOR.name}</p>
    </div>
  </section>
  <Footer />
</Layout>

<style>
  .legal { padding: 56px 0 72px; }
  .legal h1 { font-size: clamp(26px, 4vw, 34px); font-weight: 700; margin-bottom: 16px; }
  .legal .lead { color: var(--muted); margin-bottom: 28px; }
  .tokusho { width: 100%; max-width: 820px; border-collapse: collapse; }
  .tokusho th, .tokusho td { text-align: left; vertical-align: top; padding: 14px 16px; border-bottom: 1px solid var(--line); line-height: 1.8; color: #3c4043; }
  .tokusho th { width: 220px; font-weight: 700; color: var(--ink); background: var(--surface); }
  @media (max-width: 640px) {
    .tokusho, .tokusho tbody, .tokusho tr, .tokusho th, .tokusho td { display: block; width: 100%; }
    .tokusho th { border-bottom: none; padding-bottom: 2px; }
    .tokusho td { padding-top: 2px; }
  }
  .legal .updated { margin-top: 40px; font-size: 13px; color: #80868b; }
</style>
