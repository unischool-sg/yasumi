---
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import { API_BASE, LIFF_ID, LINE_URL } from "../../consts";

type PublicSchool = {
  id: string;
  name: string;
  prefecture: string;
  city: string | null;
  websiteUrl: string | null;
  logoUrl: string | null;
  verified: boolean;
};

// 学校ごとの静的ページを build 時に生成（SSG）。
// 「○○高校 休校 / 警報」の検索需要（＝警報の朝みんながググる）を自然流入で獲る。
// API 未到達時は空配列を返してビルドを壊さない（次回デプロイで再生成される）。
export async function getStaticPaths() {
  try {
    const res = await fetch(`${API_BASE}/public/schools`, { headers: { accept: "application/json" } });
    if (!res.ok) return [];
    const schools = (await res.json()) as PublicSchool[];
    return schools.map((s) => ({ params: { id: s.id }, props: { school: s } }));
  } catch {
    return [];
  }
}

// 判定結果・条件の表示ラベル（表示専用メタなので landing 側に持つ / CLAUDE.md 方針）。
type CheckResult = "NORMAL" | "WAIT" | "AM_OFF" | "PM_START" | "FULL_OFF" | "UNKNOWN";
const RESULT_LABEL: Record<CheckResult, string> = {
  NORMAL: "通常登校",
  WAIT: "自宅待機",
  AM_OFF: "午前休",
  PM_START: "午後から登校",
  FULL_OFF: "休校",
  UNKNOWN: "判定不能",
};
const CONDITION_LABEL = { WARNING_ACTIVE: "警報が出ていると", WARNING_CLEARED: "警報が解除されると" };

type SchoolDetail = PublicSchool & {
  areas: string[];
  warningTypes: string[];
  rules: { checkTime: string; result: CheckResult; condition: { type: "WARNING_ACTIVE" | "WARNING_CLEARED" } }[];
};

interface Props {
  school: PublicSchool;
}
const { school } = Astro.props;
const area = school.city ? `${school.prefecture}${school.city}` : school.prefecture;

// この学校の詳細（対象地域・対象警報・ルール）を build 時に取得。失敗時は基本情報のみで描画。
let detail: SchoolDetail | null = null;
try {
  const res = await fetch(`${API_BASE}/public/schools/${school.id}`, { headers: { accept: "application/json" } });
  if (res.ok) detail = (await res.json()) as SchoolDetail;
} catch {
  detail = null;
}
const warningTypes = detail?.warningTypes ?? [];
const areas = detail?.areas ?? [];
const rules = detail?.rules ?? [];
const warnPhrase = warningTypes.length > 0 ? warningTypes.join("・") : "暴風・大雨などの気象警報";

const title = `${school.name}は今日休校？｜気象警報の登校判定を自動化 やすみ？`;
const description = `${school.name}（${area}）で${warnPhrase}が出たら休校・午前休か、やすみ？が学校のルールに沿って自動判定しLINEで無料通知。朝、学校へ行くべきか迷わない。`;
// 学校固有の検索語（校名×休校/警報/午前休、地域×休校）を先頭に。
const keywords = [
  school.name,
  `${school.name} 休校`,
  `${school.name} 今日 休校`,
  `${school.name} 警報`,
  `${school.name} 午前休`,
  `${school.prefecture} 休校`,
  "休校",
  "午前休",
  "気象警報",
  "LINE通知",
].join(",");

// CTA は招待ディープリンクを再利用。開いた瞬間この学校の購読提案が出る（LIFF_ID 未設定時は友だち追加へ）。
const ctaUrl = LIFF_ID ? `https://liff.line.me/${LIFF_ID}?school=${school.id}` : LINE_URL;

const site = Astro.site ?? Astro.url.origin;
const officialSite = school.websiteUrl && /^https?:\/\//i.test(school.websiteUrl) ? school.websiteUrl : null;

const breadcrumbJsonLd = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "ホーム", item: new URL("/", site).toString() },
    { "@type": "ListItem", position: 2, name: "登録されている学校", item: new URL("/schools", site).toString() },
    { "@type": "ListItem", position: 3, name: school.name, item: new URL(`/schools/${school.id}`, site).toString() },
  ],
};

const faqJsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: [
    {
      "@type": "Question",
      name: `${school.name}は警報が出たら休校になりますか？`,
      acceptedAnswer: {
        "@type": "Answer",
        text: `${warnPhrase}が発表されると、学校の規則により休校・午前休などになる場合があります。やすみ？に${school.name}を登録しておくと、気象庁の警報を自動でチェックし、学校のルールに沿って判定してLINEで通知します。最終的な登校判断は学校公式の連絡をご確認ください。`,
      },
    },
    {
      "@type": "Question",
      name: `${school.name}が今日休校かどうかを自動で知る方法は？`,
      acceptedAnswer: {
        "@type": "Answer",
        text: `無料のLINEミニアプリ「やすみ？」に${school.name}を登録すると、警報の発表状況を自動で確認し、休校・午前休・午後から登校などを判定してLINEに通知します。登録は無料です。`,
      },
    },
  ],
};
---

<Layout title={title} description={description} keywords={keywords}>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(breadcrumbJsonLd)} />
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} />

  <Header />

  <!-- Hero -->
  <section class="ss-hero">
    <div class="container">
      <nav class="ss-crumb" aria-label="パンくず">
        <a href="/schools">登録されている学校</a> <span>›</span> <span>{school.name}</span>
      </nav>
      <p class="eyebrow">{area}{school.verified ? " ・ 公式連携" : ""}</p>
      <h1>{school.name}は今日、学校ある？</h1>
      <p class="ss-lead">
        {school.name}に気象警報（暴風・大雨など）が出たとき、休校・午前休になるかを
        <strong>やすみ？</strong>が学校のルールに沿って自動判定し、LINEで無料通知します。
        朝、学校へ行くべきか迷わなくなります。
      </p>
      <div class="ss-cta-row">
        <a href={ctaUrl} target="_blank" rel="noopener" class="btn btn-line">LINEで{school.name}を登録</a>
        {officialSite && (
          <a href={officialSite} target="_blank" rel="noopener" class="btn btn-ghost">学校公式サイト →</a>
        )}
      </div>
      <p class="ss-note">※学校公式のサービスではありません。最終的な登校判断は学校からの公式連絡をご確認ください。</p>
    </div>
  </section>

  <!-- How -->
  <section class="ss-how">
    <div class="container">
      <h2>{school.name}での使い方</h2>
      <ol class="ss-steps">
        <li>
          <span class="ss-num">1</span>
          <div>
            <b>LINEで登録</b>
            <p>{school.name}を選ぶだけ。対象地域・警報・判定時刻はみんなで共有されます。</p>
          </div>
        </li>
        <li>
          <span class="ss-num">2</span>
          <div>
            <b>警報を自動チェック</b>
            <p>気象庁の警報を判定時刻ごとに自動確認。あなたは何もしなくてOK。</p>
          </div>
        </li>
        <li>
          <span class="ss-num">3</span>
          <div>
            <b>LINEに通知</b>
            <p>休校・午前休・午後から登校などを、その日の朝にLINEでお知らせします。</p>
          </div>
        </li>
      </ol>
    </div>
  </section>

  <!-- この学校の判定設定（対象地域・警報・ルール） -->
  {(areas.length > 0 || warningTypes.length > 0 || rules.length > 0) && (
    <section class="ss-rules">
      <div class="container">
        <h2>{school.name}の判定設定</h2>
        <p class="ss-rules-note">やすみ？が休校・午前休を判定するために、この学校で登録されている条件です。</p>
        <div class="ss-facts">
          {areas.length > 0 && (
            <div class="ss-fact">
              <span class="ss-fact-k">対象地域</span>
              <span class="ss-fact-v">{areas.join("・")}</span>
            </div>
          )}
          {warningTypes.length > 0 && (
            <div class="ss-fact">
              <span class="ss-fact-k">対象の警報</span>
              <span class="ss-fact-v">{warningTypes.join("・")}</span>
            </div>
          )}
        </div>
        {rules.length > 0 && (
          <ul class="ss-rulelist">
            {rules.map((r) => (
              <li>
                <span class="ss-time">{r.checkTime}</span>
                <span>時点で{CONDITION_LABEL[r.condition.type]}<b>「{RESULT_LABEL[r.result]}」</b>と判定</span>
              </li>
            ))}
          </ul>
        )}
        <p class="ss-disclaimer">※設定はこの学校を登録したユーザーによるもので、学校公式のものではありません。</p>
      </div>
    </section>
  )}

  <!-- CTA -->
  <section class="cta">
    <div class="container">
      <div class="cta-card">
        <h2>{school.name}の「今日どう？」を自動で。</h2>
        <p>同じ学校のみんなで使うほど便利。まずはLINEで登録。</p>
        <a href={ctaUrl} target="_blank" rel="noopener" class="btn btn-line">LINEで{school.name}を登録</a>
      </div>
    </div>
  </section>

  <Footer />
</Layout>

<style>
  .ss-hero {
    padding: 56px 0 24px;
  }
  .ss-crumb {
    font-size: 13px;
    color: var(--muted);
    margin-bottom: 12px;
  }
  .ss-crumb a {
    color: var(--blue);
    font-weight: 600;
  }
  .ss-crumb span {
    margin: 0 4px;
  }
  .ss-hero h1 {
    font-size: clamp(28px, 5vw, 44px);
    font-weight: 700;
    margin: 6px 0 14px;
  }
  .ss-lead {
    color: var(--muted);
    font-size: 17px;
    max-width: 40em;
    margin: 0;
    line-height: 1.7;
  }
  .ss-lead strong {
    color: var(--ink);
  }
  .ss-cta-row {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 26px;
  }
  .btn-ghost {
    background: #fff;
    color: var(--blue);
    border: 1px solid #c6dafc;
  }
  .btn-ghost:hover {
    background: var(--blue-soft);
  }
  .ss-note {
    margin-top: 16px;
    font-size: 12px;
    color: var(--muted);
  }

  .ss-how {
    padding: 32px 0;
  }
  .ss-how h2 {
    font-size: clamp(22px, 3.5vw, 30px);
    font-weight: 700;
    margin: 0 0 24px;
  }
  .ss-steps {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 16px;
    max-width: 640px;
  }
  .ss-steps li {
    display: flex;
    align-items: flex-start;
    gap: 16px;
    background: #fff;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: 18px 20px;
  }
  .ss-num {
    flex-shrink: 0;
    width: 34px;
    height: 34px;
    border-radius: 50%;
    background: var(--blue-soft);
    color: var(--blue);
    font-weight: 700;
    display: grid;
    place-items: center;
  }
  .ss-steps b {
    font-size: 16px;
  }
  .ss-steps p {
    margin: 4px 0 0;
    color: var(--muted);
    font-size: 14px;
    line-height: 1.6;
  }

  .ss-rules {
    padding: 24px 0 8px;
  }
  .ss-rules h2 {
    font-size: clamp(22px, 3.5vw, 30px);
    font-weight: 700;
    margin: 0 0 8px;
  }
  .ss-rules-note {
    color: var(--muted);
    font-size: 15px;
    margin: 0 0 20px;
  }
  .ss-facts {
    display: grid;
    gap: 10px;
    max-width: 640px;
    margin-bottom: 18px;
  }
  .ss-fact {
    display: flex;
    gap: 12px;
    align-items: baseline;
  }
  .ss-fact-k {
    flex-shrink: 0;
    width: 88px;
    font-size: 13px;
    font-weight: 700;
    color: var(--blue);
  }
  .ss-fact-v {
    font-size: 15px;
    overflow-wrap: anywhere;
  }
  .ss-rulelist {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 10px;
    max-width: 640px;
  }
  .ss-rulelist li {
    display: flex;
    align-items: center;
    gap: 12px;
    background: #fff;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: 14px 18px;
    font-size: 15px;
  }
  .ss-time {
    flex-shrink: 0;
    font-weight: 700;
    color: var(--blue);
    font-variant-numeric: tabular-nums;
  }
  .ss-disclaimer {
    margin-top: 16px;
    font-size: 12px;
    color: var(--muted);
  }

  .cta {
    padding: 40px 0 88px;
  }
  .cta-card {
    background: linear-gradient(120deg, #1a73e8, #00b4d8, #1a73e8);
    background-size: 200% auto;
    animation: gradientShift 9s ease infinite;
    color: #fff;
    text-align: center;
    border-radius: var(--radius-lg);
    padding: 56px 32px;
  }
  .cta-card h2 {
    font-size: clamp(24px, 4vw, 36px);
    font-weight: 700;
  }
  .cta-card p {
    opacity: 0.92;
    font-size: 17px;
    margin: 12px 0 28px;
  }
  .btn-line {
    background: #06c755;
    color: #fff;
  }
  .btn-line:hover {
    background: #05b34c;
    transform: translateY(-1px);
    box-shadow: 0 10px 24px rgba(6, 199, 85, 0.35);
  }
</style>
