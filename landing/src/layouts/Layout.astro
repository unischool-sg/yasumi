---
interface Props {
  title?: string;
  description?: string;
}
const {
  title = "やすみ？ | 今日、学校ある？を自動で。",
  description = "学校の気象警報ルールを登録しておくだけ。休校・午前休などをLINEで自動通知。朝、学校に行くべきかを考えなくてよくするサービスです。",
} = Astro.props;
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#1a73e8" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Noto+Sans+JP:wght@400;500;700;800&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <slot />
    <style is:global>
      :root {
        --blue: #1a73e8;
        --blue-dark: #1557b0;
        --orange: #e8710a;
        --green: #1e8e3e;
        --ink: #1f1f1f;
        --muted: #5f6368;
        --line: #e8eaed;
        --surface: #f8f9fa;
        --radius: 20px;
        --radius-lg: 28px;
        --blue-soft: #e8f0fe;
        --green-soft: #e6f4ea;
        --yellow-soft: #fef7e0;
        --red-soft: #fce8e6;
        --maxw: 1120px;
        --font: "Inter", "Noto Sans JP", -apple-system, BlinkMacSystemFont, sans-serif;
      }
      * {
        box-sizing: border-box;
      }
      html {
        scroll-behavior: smooth;
      }
      body {
        margin: 0;
        font-family: var(--font);
        color: var(--ink);
        background: #fff;
        line-height: 1.7;
        -webkit-font-smoothing: antialiased;
      }
      h1,
      h2,
      h3 {
        line-height: 1.3;
        letter-spacing: -0.02em;
        margin: 0;
      }
      a {
        color: inherit;
        text-decoration: none;
      }
      .container {
        max-width: var(--maxw);
        margin: 0 auto;
        padding: 0 24px;
      }
      .btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        font-weight: 700;
        font-size: 16px;
        padding: 14px 28px;
        border-radius: 999px;
        cursor: pointer;
        transition: all 0.2s ease;
        border: none;
      }
      .btn-primary {
        background: var(--blue);
        color: #fff;
        box-shadow: 0 1px 3px rgba(26, 115, 232, 0.4);
      }
      .btn-primary:hover {
        background: var(--blue-dark);
        box-shadow: 0 4px 12px rgba(26, 115, 232, 0.35);
        transform: translateY(-1px);
      }
      .btn-ghost {
        background: transparent;
        color: var(--blue);
      }
      .btn-ghost:hover {
        background: rgba(26, 115, 232, 0.08);
      }
      .eyebrow {
        color: var(--blue);
        font-weight: 700;
        font-size: 14px;
        letter-spacing: 0.04em;
      }
      section {
        padding: 88px 0;
      }
      @media (max-width: 640px) {
        section {
          padding: 56px 0;
        }
      }

      /* スクロール表示アニメーション */
      .reveal {
        opacity: 0;
        transform: translateY(28px);
        transition:
          opacity 0.7s cubic-bezier(0.16, 1, 0.3, 1),
          transform 0.7s cubic-bezier(0.16, 1, 0.3, 1);
        transition-delay: var(--delay, 0s);
      }
      .reveal.in {
        opacity: 1;
        transform: none;
      }

      /* 動きのユーティリティ */
      @keyframes floaty {
        0%,
        100% {
          transform: translateY(0);
        }
        50% {
          transform: translateY(-12px);
        }
      }
      @keyframes gradientShift {
        0% {
          background-position: 0% 50%;
        }
        50% {
          background-position: 100% 50%;
        }
        100% {
          background-position: 0% 50%;
        }
      }
      @keyframes blob {
        0%,
        100% {
          transform: translate(0, 0) scale(1);
        }
        33% {
          transform: translate(20px, -20px) scale(1.08);
        }
        66% {
          transform: translate(-16px, 12px) scale(0.96);
        }
      }
      .float {
        animation: floaty 5s ease-in-out infinite;
      }

      @media (prefers-reduced-motion: reduce) {
        .reveal {
          opacity: 1 !important;
          transform: none !important;
          transition: none;
        }
        .float,
        .blob {
          animation: none !important;
        }
      }
    </style>
  </body>
</html>
